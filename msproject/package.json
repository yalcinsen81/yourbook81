{
  "name": "msproject-clone",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "vite build && vite preview --open",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.mcp.json",
    "build:mcp": "esbuild mcp/server.ts --bundle --platform=node --format=esm --target=node20 --minify --outfile=mcp/dist/msproject-mcp.mjs",
    "mcp:smoke": "node mcp/smoke.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}
