# yourbook — ortam değişkenleri örneği
# Bu dosyayı `.env` olarak kopyalayıp kendi değerlerinizi girin.

# Supabase proje URL'i
VITE_SUPABASE_URL=https://<proje-ref>.supabase.co

# ⚠️ ÖNEMLİ: Vite `VITE_*` değişkenlerini İSTEMCİ paketine dahil eder.
# Bu yüzden buraya YALNIZCA herkese açık (publishable/anon) anahtar yazın.
#
#   ✔ sb_publishable_...        (yeni tip publishable key)
#   ✔ eyJ...  (JWT, payload.role = "anon")
#
#   ✘ sb_secret_...             (service-role — RLS'i atlar, ASLA istemciye koymayın)
#   ✘ eyJ...  (payload.role = "service_role")
#
# Supabase Dashboard → Project Settings → API bölümünden "anon / publishable"
# anahtarını kopyalayın. Service-role anahtarını yalnızca sunucu tarafında
# (Vercel'de VITE_ öneki OLMADAN) kullanın.
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxx
